# Target app
BASE_URL=https://reference-app.autotests.ai/
API_BASE_URL=https://reference-app.autotests.ai/

# Browser — leave REMOTE_URL empty for local Chrome
BROWSER=chrome
BROWSER_VERSION=148.0
BROWSER_SIZE=1740x1080
HEADLESS=true

# Remote Selenoid (CI / prod smoke)
# REMOTE_URL=https://user1:1234@selenoid.qa.guru/wd/hub
REMOTE_URL=
ENABLE_VNC=false
ENABLE_VIDEO=false

# Full attachments demo (Jenkins: reference-app-tests-freestyle-python-allure3-full-attachments)
# ATTACH_FULL=true
# ENABLE_HAR=true
# VIDEO_FOLDER=https://selenoid.qa.guru/video/
